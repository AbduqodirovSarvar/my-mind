{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimits": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 3, "WindowSeconds": 3600 }
  }
}
